<% flash.each do |type, message| %>
  <% bootstrap_type = type.to_s == "notice" ? "success" : "danger" %>
  <div class="alert alert-<%= bootstrap_type %> alert-dismissible fade show" role="alert">
    <%= message %>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
  </div>
<% end %>
