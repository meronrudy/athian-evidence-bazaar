<% links = [
  ["Dashboard", root_path, "01"],
  ["AgEvidence Launchpad", agevidence_root_path, "02"],
  ["Country Programs", agevidence_country_programs_path, "03"],
  ["Integration Inbox", integrations_events_path, "04"],
  ["Evidence Explorer", evidence_index_path(avsa_id: canonical_avsa&.id), "05"],
  ["Receipt Chain", canonical_avsa ? avsa_path(canonical_avsa) : root_path, "06"],
  ["Bundle Builder", bundle_exports_path, "07"],
  ["Co-Claim Workbench", canonical_avsa&.claim_group ? avsa_co_claim_group_path(canonical_avsa) : root_path, "08"],
  ["VVB Console", verifier_console_path(avsa_id: canonical_avsa&.id), "09"],
  ["Producer Ledger", producer_payments_path, "10"],
  ["Methodology Migration", methodology_migrations_path, "11"],
  ["Evidence Marketplace", evidence_marketplace_index_path, "12"],
  ["Protocols", protocols_path, "13"]
] %>

<aside class="app-sidebar d-none d-lg-flex flex-column">
  <div class="sidebar-kicker">Evidence bazaar</div>
  <nav class="nav nav-pills flex-column gap-1" aria-label="Application sections">
    <% links.each do |label, path, index| %>
      <%= link_to path, class: "nav-link #{'active' if current_page?(path)}" do %>
        <span class="nav-index"><%= index %></span>
        <span><%= label %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="sidebar-note mt-auto">
    <strong>Truth boundary</strong>
    <p class="mb-0">This UI orchestrates and explains. The receipt and released verifier remain authoritative.</p>
  </div>

  <div class="sidebar-note mt-3">
    <strong>Strategic map</strong>
    <% strategic_moves.each do |index, move, feature| %>
      <p class="mb-1"><span class="nav-index"><%= index %></span> <%= feature %>: <%= move %></p>
    <% end %>
  </div>
</aside>

<div class="offcanvas offcanvas-start" tabindex="-1" id="mobileSidebar" aria-labelledby="mobileSidebarLabel">
  <div class="offcanvas-header">
    <h2 class="offcanvas-title h5" id="mobileSidebarLabel">Evidence Plane</h2>
    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
  </div>
  <div class="offcanvas-body">
    <nav class="nav nav-pills flex-column gap-2">
      <% links.each do |label, path, index| %>
        <%= link_to path, class: "nav-link", data: { bs_dismiss: "offcanvas" } do %>
          <span class="nav-index"><%= index %></span>
          <span><%= label %></span>
        <% end %>
      <% end %>
    </nav>
    <div class="alert alert-secondary mt-4 mb-0 small">
      Hosted state is a projection. Portable receipts and independent verification are the trust boundary.
    </div>
    <div class="alert alert-boundary mt-3 mb-0 small">
      <% strategic_moves.each do |index, move, feature| %>
        <div><span class="nav-index"><%= index %></span> <%= feature %>: <%= move %></div>
      <% end %>
    </div>
  </div>
</div>
