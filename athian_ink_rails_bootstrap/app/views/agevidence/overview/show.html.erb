<% content_for :title, "AgEvidence Developer Launchpad" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Athian AgEvidence</p>
    <h1>Evidence launchpad</h1>
    <p class="lead">Source records, model candidates, human review, country-program determinations, INK receipts, and external reliance in one inspectable chain.</p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "Developer OS", agevidence_developer_os_path, class: "btn btn-primary" %>
    <%= link_to "New project", new_agevidence_developer_project_path, class: "btn btn-primary" %>
    <%= link_to "Country programs", agevidence_country_programs_path, class: "btn btn-outline-primary" %>
    <%= link_to "Determinations", agevidence_determinations_path, class: "btn btn-outline-primary" %>
  </div>
</section>

<div class="alert alert-boundary">
  Model output is candidate evidence only. Country adapters and human review create bounded determinations; receipts and bundles carry the portable proof boundary.
</div>

<section class="ei-system-chain" aria-label="Active institutional chain">
  <% @system_chain.each_with_index do |node, index| %>
    <%= render "shared/evidence_instrument/evidence_plate",
      eyebrow: node.fetch(:eyebrow),
      title: node.fetch(:title),
      identifier: node.fetch(:identifier),
      status: node.fetch(:status),
      meta: node.fetch(:meta),
      basis_url: node.fetch(:basis_url) %>
    <% if index < @system_chain.length - 1 %>
      <div class="ei-chain-operator" aria-hidden="true">-&gt;</div>
    <% end %>
  <% end %>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Projects</p>
      <h2>Evidence reasoning maps</h2>
    </div>
    <%= link_to "All accounts", agevidence_developer_accounts_path, class: "btn btn-sm btn-outline-secondary" %>
  </div>

  <div class="vstack gap-2">
    <% @projects.each do |project| %>
      <% determination = project.country_determinations.order(evaluated_at: :desc).first %>
      <%= render "shared/evidence_instrument/evidence_plate",
        eyebrow: "Developer project",
        title: project.name,
        identifier: project.developer_account.name,
        status: determination&.status || project.integration_status,
        meta: [
          ["Claim", truncate(project.target_claim, length: 80), false],
          ["Protocol", project.protocol&.display_name || "Unmapped", false],
          ["Evidence root", compact_digest(project.evidence_graph_root), true],
          ["Sources", project.source_records.count, true],
          ["Determination", determination ? "DET-#{determination.id}" : "Pending", true],
          ["Integration", project.integration_status.humanize, false]
        ],
        basis_url: agevidence_developer_project_path(project) %>
    <% end %>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Commercial layer</p>
      <h2>Premium artifact pipeline</h2>
    </div>
    <span class="small text-muted"><%= @product_notice %></span>
  </div>

  <div class="row g-3">
    <% @engagements.each do |engagement| %>
      <div class="col-md-6 col-xl-4">
        <%= render "shared/evidence_instrument/evidence_plate",
          eyebrow: "Artifact engagement",
          title: Agevidence::ProductCatalog.fetch(engagement.product_code).fetch("name"),
          identifier: engagement.developer_project.name,
          status: engagement.pipeline_stage,
          meta: [
            ["Stage", engagement.pipeline_stage.humanize, false],
            ["Price", money(engagement.price_label / 100.0, engagement.currency), false],
            ["Bundle", engagement.evidence_bundle&.artifact_filename || "Pending", true]
          ],
          basis_url: agevidence_developer_project_artifact_engagement_path(engagement.developer_project, engagement) %>
      </div>
    <% end %>
  </div>
</section>
