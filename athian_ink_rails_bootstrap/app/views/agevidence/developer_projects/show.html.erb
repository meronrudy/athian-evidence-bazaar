<% content_for :title, @project.name %>

<section class="page-header">
  <div>
    <p class="eyebrow">Project Evidence Map</p>
    <h1><%= @project.name %></h1>
    <p class="lead"><%= @project.target_claim %></p>
  </div>
  <div class="d-flex gap-2 flex-wrap">
    <%= link_to "Source console", agevidence_developer_project_source_records_path(@project), class: "btn btn-primary" %>
    <%= link_to "Run fixture extraction", new_agevidence_developer_project_model_run_path(@project), class: "btn btn-primary" %>
    <%= link_to "Quote artifact", new_agevidence_developer_project_pricing_quote_path(@project), class: "btn btn-outline-primary" %>
    <%= link_to "Developer OS", agevidence_developer_os_path, class: "btn btn-outline-secondary" %>
  </div>
</section>

<div class="alert alert-boundary">Claim -> source -> model run -> candidate -> human review -> receipt -> artifact. Confidence is never displayed as scientific validity.</div>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Developer OS paths</p>
      <h2>Two ways into the same evidence state</h2>
    </div>
  </div>
  <div class="row g-3">
    <div class="col-lg-6">
      <article class="resource-card h-100">
        <span class="badge text-bg-dark">Event Inbox Path</span>
        <h3 class="mt-3">Operational event bridge</h3>
        <p>Existing Athian systems publish signed business events. Rails preserves them, projects evidence state, and sends receipt work through the outbox.</p>
        <%= link_to "Open inbox", integrations_events_path, class: "btn btn-sm btn-outline-primary" %>
      </article>
    </div>
    <div class="col-lg-6">
      <article class="resource-card h-100">
        <span class="badge text-bg-success">Source Records Path</span>
        <h3 class="mt-3">Self-service references</h3>
        <p>Start from controlled source references, then run fixture-backed extraction, append review decisions, and assemble a priced artifact.</p>
        <%= link_to "Manage sources", agevidence_developer_project_source_records_path(@project), class: "btn btn-sm btn-primary" %>
      </article>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Global-to-local map</p>
      <h2>Reusable evidence, replaceable interpretation</h2>
    </div>
  </div>
  <div class="row g-3">
    <div class="col-lg-6">
      <article class="resource-card h-100">
        <h3>Global evidence</h3>
        <ol class="mb-0">
          <li>Source records</li>
          <li>Evidence candidates</li>
          <li>Human decisions</li>
          <li>Canonical receipts</li>
          <li>Evidence graph root: <code><%= compact_digest(@project.evidence_graph_root) %></code></li>
        </ol>
      </article>
    </div>
    <div class="col-lg-6">
      <article class="resource-card h-100">
        <h3>Local interpretation</h3>
        <ol class="mb-0">
          <li>Country adapter</li>
          <li>Method compatibility</li>
          <li>Missing local evidence</li>
          <li>Claim and verification policy</li>
          <li>Premium artifact and reliance event</li>
        </ol>
      </article>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Source records</p>
      <h2>Controlled source-document commitments</h2>
    </div>
    <%= link_to "Add source", agevidence_developer_project_source_records_path(@project), class: "btn btn-sm btn-primary" %>
  </div>
  <% if @source_records.any? %>
    <div class="row g-2 mb-3">
      <% @source_records.first(4).each do |record| %>
        <div class="col-md-6 col-xl-3">
          <div class="resource-card h-100">
            <span class="badge text-bg-info"><%= record.status.humanize %></span>
            <strong class="d-block mt-2"><%= record.document_id %></strong>
            <small><%= record.evidence_type %></small>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
  <div class="table-responsive">
    <table class="table table-sm align-middle">
      <thead>
        <tr>
          <th>Document</th>
          <th>Commitment</th>
          <th>Controlled URI</th>
        </tr>
      </thead>
      <tbody>
        <% @project.source_documents.each do |document| %>
          <tr>
            <td><%= document.fetch(:document_id) %></td>
            <td><code><%= compact_digest(document.fetch(:commitment)) %></code></td>
            <td><code><%= document.fetch(:controlled_uri) %></code></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Country determinations</p>
      <h2>Append-only method compatibility</h2>
    </div>
  </div>
  <div class="row g-3">
    <% @country_determinations.each do |determination| %>
      <div class="col-md-6">
        <article class="resource-card h-100">
          <span class="badge text-bg-warning"><%= determination.status.humanize %></span>
          <h3 class="mt-3"><%= determination.country_program.country_code %> · <%= determination.country_adapter.adapter_id %></h3>
          <p>Missing evidence: <%= determination.missing_evidence.size %></p>
          <p class="mb-0">Receipt: <%= determination.receipt ? compact_digest(determination.receipt.body_digest) : "Pending" %></p>
        </article>
      </div>
    <% end %>
    <% if @country_determinations.empty? %>
      <p class="text-muted">No local method compatibility determinations have been appended yet.</p>
    <% end %>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Model runs</p>
      <h2>Adapter execution records</h2>
    </div>
  </div>
  <div class="list-group">
    <% @model_runs.each do |run| %>
      <%= link_to agevidence_model_run_path(run), class: "list-group-item list-group-item-action" do %>
        <div class="d-flex justify-content-between">
          <strong><%= run.model_adapter.display_name %></strong>
          <span class="badge text-bg-secondary"><%= run.status.humanize %></span>
        </div>
        <span class="text-muted"><%= run.evidence_candidates.size %> candidates · <%= run.evidence_gaps.size %> gaps · output <%= compact_digest(run.output_digest) %></span>
      <% end %>
    <% end %>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Review workbench</p>
      <h2>Candidates and material gaps</h2>
    </div>
  </div>
  <div class="row g-3">
    <div class="col-lg-7">
      <div class="list-group">
        <% @candidates.each do |candidate| %>
          <%= link_to agevidence_evidence_candidate_path(candidate), class: "list-group-item list-group-item-action" do %>
            <span class="badge text-bg-info"><%= candidate.review_status.humanize %></span>
            <strong class="d-block mt-2"><%= candidate.claim_text %></strong>
            <small><%= candidate.source_reference_labels.join(", ") %></small>
          <% end %>
        <% end %>
      </div>
    </div>
    <div class="col-lg-5">
      <div class="list-group">
        <% @gaps.each do |gap| %>
          <%= link_to agevidence_evidence_gap_path(gap), class: "list-group-item list-group-item-action" do %>
            <span class="badge text-bg-warning"><%= gap.severity.humanize %></span>
            <strong class="d-block mt-2"><%= gap.requirement %></strong>
            <small><%= gap.resolution_status.humanize %></small>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Sandbox pricing</p>
      <h2>Quote-to-order artifact flow</h2>
    </div>
    <%= link_to "Build quote", new_agevidence_developer_project_pricing_quote_path(@project), class: "btn btn-sm btn-primary" %>
  </div>
  <div class="row g-3">
    <div class="col-lg-6">
      <article class="resource-card h-100">
        <h3>Quotes</h3>
        <div class="list-group list-group-flush">
          <% @pricing_quotes.first(5).each do |quote| %>
            <%= link_to agevidence_developer_project_pricing_quote_path(@project, quote), class: "list-group-item list-group-item-action px-0" do %>
              <div class="d-flex justify-content-between">
                <strong><%= quote.product_code.humanize %></strong>
                <span><%= money(quote.amount_cents / 100.0, quote.currency) %></span>
              </div>
              <small><%= quote.status.humanize %> · <%= quote.pricing_version %></small>
            <% end %>
          <% end %>
          <% if @pricing_quotes.empty? %>
            <p class="text-muted mb-0">No sandbox quotes yet.</p>
          <% end %>
        </div>
      </article>
    </div>
    <div class="col-lg-6">
      <article class="resource-card h-100">
        <h3>Artifact orders</h3>
        <div class="list-group list-group-flush">
          <% @artifact_orders.first(5).each do |order| %>
            <%= link_to agevidence_developer_project_artifact_order_path(@project, order), class: "list-group-item list-group-item-action px-0" do %>
              <div class="d-flex justify-content-between">
                <strong><%= order.external_id %></strong>
                <span class="badge text-bg-secondary"><%= order.status.humanize %></span>
              </div>
              <small><%= order.product_code.humanize %> · <%= money(order.amount_cents / 100.0, order.currency) %></small>
            <% end %>
          <% end %>
          <% if @artifact_orders.empty? %>
            <p class="text-muted mb-0">No artifact orders yet.</p>
          <% end %>
        </div>
      </article>
    </div>
  </div>
</section>

<section class="content-section">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Commercial artifacts</p>
      <h2>Engagements tied to this project</h2>
    </div>
    <span class="small text-muted"><%= @product_notice %></span>
  </div>
  <div class="row g-3">
    <% @engagements.each do |engagement| %>
      <div class="col-md-6">
        <%= link_to agevidence_developer_project_artifact_engagement_path(@project, engagement), class: "resource-card d-block text-decoration-none h-100" do %>
          <h3><%= Agevidence::ProductCatalog.fetch(engagement.product_code).fetch("name") %></h3>
          <p><%= engagement.pipeline_stage.humanize %> · <%= engagement.commercial_status.humanize %></p>
          <strong><%= money(engagement.price_label / 100.0, engagement.currency) %></strong>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
