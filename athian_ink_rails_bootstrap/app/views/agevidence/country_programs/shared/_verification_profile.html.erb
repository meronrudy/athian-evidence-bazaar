<article class="resource-card h-100">
  <h3>Verification profile</h3>
  <% country_adapters.each do |adapter| %>
    <% profile = adapter.country_verification_profile %>
    <p class="mb-1"><strong><%= profile&.profile_id || "Unassigned" %></strong></p>
    <p class="text-muted mb-0"><%= profile&.version || "No version" %></p>
  <% end %>
</article>
