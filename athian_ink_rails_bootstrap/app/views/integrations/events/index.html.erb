<% content_for :title, "Integration Event Inbox" %>

<div class="page-header">
  <div>
    <p class="eyebrow mb-2">Append-only bridge</p>
    <h1>Integration Event Inbox</h1>
    <p class="lead">Rails receives signed upstream business events, preserves the exact payload, and creates evidence projections without becoming the operational source of record.</p>
  </div>
  <div class="page-actions">
    <%= link_to "Sources", integrations_sources_path, class: "btn btn-outline-primary" %>
    <%= link_to "Receipt outbox", integrations_outbox_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Dead letter", integrations_dead_letter_path, class: "btn btn-outline-danger" %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-body">
    <%= form_with url: integrations_events_path, method: :get, local: true, class: "row gy-2 gx-2 align-items-end" do |form| %>
      <div class="col-md-3">
        <%= form.label :source_id, "Source", class: "form-label" %>
        <%= form.collection_select :source_id, @sources, :id, :key, { include_blank: "All sources", selected: params[:source_id] }, class: "form-select" %>
      </div>
      <div class="col-md-3">
        <%= form.label :event_type, "Event type", class: "form-label" %>
        <%= form.text_field :event_type, value: params[:event_type], class: "form-control" %>
      </div>
      <div class="col-md-3">
        <%= form.label :status, "Status", class: "form-label" %>
        <%= form.select :status, IntegrationEvent::PROCESSING_STATUSES, { include_blank: "All statuses", selected: params[:status] }, class: "form-select" %>
      </div>
      <div class="col-md-3">
        <%= form.submit "Filter", class: "btn btn-primary" %>
      </div>
    <% end %>
  </div>
</div>

<div class="card">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Received</th>
          <th>Source</th>
          <th>Event</th>
          <th>Subject</th>
          <th>Signature</th>
          <th>Schema</th>
          <th>Processing</th>
        </tr>
      </thead>
      <tbody>
        <% @events.each do |event| %>
          <tr>
            <td><%= event.received_at&.to_fs(:db) %></td>
            <td><%= link_to event.integration_source.key, integrations_source_path(event.integration_source) %></td>
            <td>
              <%= link_to event.external_event_id, integrations_event_path(event) %>
              <span class="d-block text-muted small"><%= event.event_type %></span>
            </td>
            <td><%= event.external_object_type %><span class="d-block text-muted small"><%= event.external_object_id %></span></td>
            <td><span class="badge text-bg-secondary"><%= event.signature_status %></span></td>
            <td><span class="badge text-bg-secondary"><%= event.schema_status %></span></td>
            <td><span class="badge text-bg-primary"><%= event.processing_status %></span></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
