<% content_for :title, "Public Evidence Verifier" %>

<section class="page-header">
  <div>
    <p class="eyebrow">Athian INK / Verify</p>
    <h1>Public receipt inspection</h1>
    <p class="lead">Verify receipt integrity and provenance without entering the application workflow.</p>
  </div>
</section>

<% if @identifier.present? %>
  <%= render "shared/evidence_instrument/verifier_result",
    title: @receipt ? "receipt-#{@receipt.id}" : @identifier,
    status: @receipt ? @receipt.integrity_status : "not_found",
    checks: @checks,
    meta: @meta,
    kicker: "Athian INK / Verify" %>
<% else %>
  <section class="ei-verifier">
    <header>
      <div>
        <div class="ei-kicker">Athian INK / Verify</div>
        <h1>Receipt lookup</h1>
      </div>
      <%= ei_status("unverified") %>
    </header>

    <%= form_with url: public_verifier_path, method: :post, local: true, class: "vstack gap-3" do |form| %>
      <div>
        <%= label_tag :receipt_id, "Receipt ID or digest", class: "form-label" %>
        <%= text_field_tag :receipt_id, nil, class: "form-control font-monospace", placeholder: "receipt-1 or sha256:..." %>
      </div>
      <div><%= form.submit "Verify receipt", class: "btn btn-primary" %></div>
    <% end %>

    <div class="ei-verifier-boundary">
      <div>
        <div class="ei-kicker">This verifies</div>
        <p>Receipt integrity, commitments, lifecycle state, and provenance carried by INK.</p>
      </div>
      <div>
        <div class="ei-kicker">This does not assert</div>
        <p>Independent truth of underlying physical events outside the committed evidence and review boundary.</p>
      </div>
    </div>
  </section>
<% end %>

<% if @identifier.present? && @receipt.nil? %>
  <section class="ei-field-empty">
    <div class="ei-kicker">Not found</div>
    <h2>Receipt not found</h2>
    <p>No receipt or digest matched <span class="font-monospace"><%= @identifier %></span>.</p>
  </section>
<% end %>
