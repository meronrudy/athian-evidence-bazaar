<div class="max-w-4xl mx-auto py-8 px-4 sm:px-6 lg:px-8">
  <div class="bg-white rounded-lg shadow-md p-6">
    <h1 class="text-2xl font-bold text-gray-800 mb-6">Public Evidence Verifier</h1>
    <p class="text-gray-600 mb-6">Verify the integrity and authenticity of AgEvidence receipts and evidence records.</p>

    <div class="space-y-6">
      <!-- Receipt ID Lookup -->
      <div>
        <h2 class="text-xl font-semibold text-gray-700 mb-3">Verify by Receipt ID</h2>
        <form id="receipt-lookup-form" class="space-y-4">
          <div>
            <label for="receipt-id" class="block text-sm font-medium text-gray-700 mb-1">Receipt ID</label>
            <input type="text" id="receipt-id" name="receipt_id" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Enter receipt ID (e.g., agv-abc123...)">
          </div>
          <button type="submit" class="w-full bg-blue-600 text-white px-4 py-2 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
            Verify Receipt
          </button>
        </form>
      </div>

      <!-- URL Lookup -->
      <div>
        <h2 class="text-xl font-semibold text-gray-700 mb-3">Verify by URL</h2>
        <form id="url-lookup-form" class="space-y-4">
          <div>
            <label for="verification-url" class="block text-sm font-medium text-gray-700 mb-1">Evidence URL</label>
            <input type="url" id="verification-url" name="url" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://example.com/evidence/...">
          </div>
          <button type="submit" class="w-full bg-green-600 text-white px-4 py-2 rounded-md hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500 focus:ring-offset-2">
            Lookup Evidence
          </button>
        </form>
      </div>

      <!-- JSON Bundle Upload -->
      <div>
        <h2 class="text-xl font-semibold text-gray-700 mb-3">Verify JSON Bundle</h2>
        <form id="bundle-upload-form" class="space-y-4">
          <div>
            <label for="json-bundle" class="block text-sm font-medium text-gray-700 mb-1">Upload Evidence Bundle (.json)</label>
            <input type="file" id="json-bundle" name="json_bundle" accept=".json" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            <p class="mt-1 text-sm text-gray-500">Upload a complete evidence bundle for integrity verification</p>
          </div>
          <button type="submit" class="w-full bg-purple-600 text-white px-4 py-2 rounded-md hover:bg-purple-700 focus:outline-none focus:ring-2 focus:ring-purple-500 focus:ring-offset-2">
            Verify Bundle
          </button>
        </form>
      </div>
    </div>

    <!-- Results Area -->
    <div id="verification-results" class="mt-8 hidden">
      <div id="verification-content"></div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  // Handle receipt ID lookup
  const receiptForm = document.getElementById('receipt-lookup-form');
  if (receiptForm) {
    receiptForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const receiptId = document.getElementById('receipt-id').value.trim();
      if (!receiptId) return;
      
      fetch(`/verify/${encodeURIComponent(receiptId)}`, {
        method: 'GET',
        headers: { 'Accept': 'application/json' }
      })
      .then(response => response.json())
      .then(data => {
        displayResults(data);
      })
      .catch(error => {
        displayError('Failed to verify receipt: ' + error.message);
      });
    });
  }

  // Handle URL lookup
  const urlForm = document.getElementById('url-lookup-form');
  if (urlForm) {
    urlForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const url = document.getElementById('verification-url').value.trim();
      if (!url) return;
      
      fetch(`/verify/lookup_by_url?url=${encodeURIComponent(url)}`, {
        method: 'GET',
        headers: { 'Accept': 'application/json' }
      })
      .then(response => response.json())
      .then(data => {
        displayResults(data);
      })
      .catch(error => {
        displayError('Failed to lookup evidence: ' + error.message);
      });
    });
  }

  // Handle bundle upload
  const bundleForm = document.getElementById('bundle-upload-form');
  if (bundleForm) {
    bundleForm.addEventListener('submit', function(e) {
      e.preventDefault();
      const fileInput = document.getElementById('json-bundle');
      const file = fileInput.files[0];
      if (!file) return;
      
      const formData = new FormData();
      formData.append('verification[json_bundle]', file);
      
      fetch('/verify', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      })
      .then(response => response.json())
      .then(data => {
        displayResults(data);
      })
      .catch(error => {
        displayError('Failed to verify bundle: ' + error.message);
      });
    });
  }

  function displayResults(data) {
    const resultsDiv = document.getElementById('verification-results');
    const contentDiv = document.getElementById('verification-content');
    
    resultsDiv.classList.remove('hidden');
    
    if (data.status === 'success' || data.status === 'found') {
      contentDiv.innerHTML = `
        <div class="bg-green-50 border-l-4 border-green-500 p-4">
          <h3 class="text-lg font-semibold text-green-800 mb-2">Verification Successful</h3>
          <p class="text-gray-700">${data.verification ? JSON.stringify(data.verification, null, 2) : JSON.stringify(data, null, 2)}</p>
        </div>
      `;
    } else {
      contentDiv.innerHTML = `
        <div class="bg-red-50 border-l-4 border-red-500 p-4">
          <h3 class="text-lg font-semibold text-red-800 mb-2">Verification Failed</h3>
          <p class="text-gray-700">${data.error || 'Unknown error occurred'}</p>
        </div>
      `;
    }
  }

  function displayError(message) {
    const resultsDiv = document.getElementById('verification-results');
    const contentDiv = document.getElementById('verification-content');
    
    resultsDiv.classList.remove('hidden');
    contentDiv.innerHTML = `
      <div class="bg-red-50 border-l-4 border-red-500 p-4">
        <h3 class="text-lg font-semibold text-red-800 mb-2">Error</h3>
        <p class="text-gray-700">${message}</p>
      </div>
    `;
  }
});
</script>