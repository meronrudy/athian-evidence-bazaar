{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athian.agevidence.model_run.v1",
  "title": "Athian AgEvidence Model Run Primitive",
  "type": "object",
  "required": [
    "model_id",
    "model_version",
    "implementation_digest",
    "input_commitments",
    "parameters",
    "execution_environment",
    "started_at",
    "completed_at",
    "outputs",
    "limitations",
    "verification"
  ],
  "properties": {
    "schema_id": { "const": "athian.agevidence.model_run.v1" },
    "primitive_type": { "const": "ModelRun" },
    "model_id": { "type": "string", "minLength": 1 },
    "model_version": { "type": "string", "minLength": 1 },
    "implementation_digest": { "type": "string", "minLength": 1 },
    "input_commitments": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "parameters": { "type": "object" },
    "execution_environment": { "type": "object" },
    "started_at": { "type": "string", "minLength": 1 },
    "completed_at": { "type": "string", "minLength": 1 },
    "outputs": {
      "type": "array",
      "items": {},
      "minItems": 1
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "verification": { "type": "object" },
    "metadata": { "type": "object" }
  },
  "additionalProperties": true
}
