{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "athian.agevidence.derived_observation.v1",
  "title": "Athian AgEvidence DerivedObservation Primitive",
  "type": "object",
  "required": ["subject", "observable", "value", "unit", "observed_at", "inputs", "transformation"],
  "properties": {
    "schema_id": { "const": "athian.agevidence.derived_observation.v1" },
    "primitive_type": { "const": "DerivedObservation" },
    "subject": { "type": "string", "minLength": 1 },
    "observable": { "type": "string", "minLength": 1 },
    "value": {},
    "unit": { "type": "string", "minLength": 1 },
    "observed_at": { "type": "string", "minLength": 1 },
    "inputs": { "type": "array", "minItems": 1 },
    "transformation": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    },
    "derived_at": { "type": "string" },
    "source_records": { "type": "array", "items": { "type": "object" } },
    "metadata": { "type": "object" },
    "limitations": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true
}
